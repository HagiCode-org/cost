{
  "name": "ai-replacement-cost-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:i18n && astro dev --host 0.0.0.0 --port 36291",
    "build": "export NODE_ENV=\"${NODE_ENV:-production}\"; npm run prepare:i18n && npm run sync:footer-sites && npm run typecheck && astro build && node ./scripts/sync-seo-assets.mjs && node ./scripts/check-built-site.mjs",
    "lint": "eslint .",
    "preview": "astro preview --host 0.0.0.0",
    "typecheck": "astro check && tsc -p tsconfig.build.json",
    "test": "npm run prepare:i18n && vitest run",
    "test:watch": "npm run prepare:i18n && vitest",
    "test:ui": "npm run prepare:i18n && vitest --ui",
    "i18n:audit": "hagi18n audit --config hagi18n.yaml",
    "i18n:report": "hagi18n report --config hagi18n.yaml",
    "i18n:doctor": "hagi18n doctor --config hagi18n.yaml",
    "i18n:sync": "hagi18n sync --config hagi18n.yaml",
    "i18n:sync:write": "hagi18n sync --config hagi18n.yaml --write",
    "i18n:prune": "hagi18n prune --config hagi18n.yaml",
    "i18n:prune:write": "hagi18n prune --config hagi18n.yaml --write",
    "i18n:generate": "node ./scripts/generate-i18n-resources.mjs",
    "prepare:i18n": "npm run i18n:generate",
    "i18n:check": "npm run i18n:doctor && npm run i18n:generate -- --check",
    "sync:footer-sites": "node ./scripts/fetch-sites-snapshot.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@base-ui/react": "^1.1.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/newsreader": "^5.2.7",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "i18next": "^25.8.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.3",
    "react-redux": "^9.2.0",
    "react-resizable-panels": "^3.0.6",
    "react-syntax-highlighter": "^16.1.0",
    "shadcn": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vaul": "^1.1.2",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.1",
    "@hagicode/hagi18n": "^0.1.1",
    "@hagicode/hagilight-core": "^0.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/ui": "^5.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.1",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.2"
  }
}