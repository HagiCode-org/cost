---
import "@/index.css"
import i18n, {
  defaultLanguage,
  supportedLanguages,
  type SupportedLanguage,
} from "@/i18n/config"
import { buildAllSchemas } from "@/lib/seo/schema-generator"
import { resolveSEOConfig, siteConfig } from "@/config/seo"
import IncomeTokenExperienceIsland from "@/components/IncomeTokenExperienceIsland"
import GoogleAnalytics from "@hagicode/hagilight-core/GoogleAnalytics"
import Analytics51LA from "@hagicode/hagilight-core/Analytics51LA"
import SEOHead from "@hagicode/hagilight/SEOHead"
import { resolveFaviconHeadEntry } from "@hagicode/hagilight-core/favicon"
import sharedFaviconUrl from "@hagicode/hagilight-core/favicon.ico"
import Footer from "@hagicode/hagilight/Footer"
import PromotoBanner from "@hagicode/hagilight-core/PromotoBanner"
import { getHomePageContent } from "@/features/home/content/home-content"

const metadata = resolveSEOConfig(defaultLanguage)
const schemas = buildAllSchemas(defaultLanguage)

const costSiteId = "cost-calculator"
const costSiteUrl = new URL(siteConfig.basePath || "/", siteConfig.origin).toString()

function buildCostFooterLinks(language: SupportedLanguage) {
  const t = i18n.getFixedT(language)
  const content = getHomePageContent(t)
  return {
    siteId: costSiteId,
    siteUrl: costSiteUrl,
    overrides: {
      icpFiling: {
        href: content.footer.registrationItems[0]?.href ?? "https://beian.miit.gov.cn/",
        label: content.footer.registrationItems[0]?.label,
        external: true,
      },
      publicSecurityFiling: {
        href: content.footer.registrationItems[1]?.href ?? "http://www.beian.gov.cn/portal/registerSystemInfo",
        label: content.footer.registrationItems[1]?.label,
        external: true,
      },
    },
    extraLinks: {
      quick: [
        {
          id: "cost-github",
          label: t("footer.links.github"),
          href: "https://github.com/HagiCode-org/site",
          external: true,
        },
        {
          id: "cost-steam",
          label: t("footer.links.steam"),
          href: "https://store.steampowered.com/app/4625540/Hagicode/",
          external: true,
        },
        {
          id: "cost-pricing",
          label: t("footer.links.pricing"),
          href: "https://openai.com/api/pricing/",
          external: true,
        },
      ],
    },
  }
}

// The bundled HagiCode icon, emitted by Astro from the package asset. hagilightFavicon() writes to the
// Astro config head, which this layout does not render, so the same entry is supplied here.
const faviconEntry = resolveFaviconHeadEntry([], { href: sharedFaviconUrl })

const seoHeadEntries = [
  ...(faviconEntry ? [faviconEntry] : []),
  { tag: "meta", attrs: { name: "robots", content: "index,follow" } },
  { tag: "meta", attrs: { name: "keywords", content: metadata.keywords.join(", ") } },
  { tag: "meta", attrs: { property: "og:type", content: "website" } },
  { tag: "meta", attrs: { property: "og:url", content: metadata.url } },
  { tag: "meta", attrs: { property: "og:site_name", content: metadata.siteName } },
  { tag: "meta", attrs: { property: "og:locale", content: metadata.locale } },
  ...metadata.ogLocaleAlternates.map((locale) => ({
    tag: "meta",
    attrs: { property: "og:locale:alternate", content: locale, "data-generated": "og:locale:alternate" },
  })),
  { tag: "meta", attrs: { name: "twitter:card", content: "summary_large_image" } },
  { tag: "meta", attrs: { name: "twitter:url", content: metadata.url } },
  ...metadata.alternates.map((alternate) => ({
    tag: "link",
    attrs: { rel: "alternate", hreflang: alternate.hrefLang, href: alternate.url, "data-generated": "alternate-language" },
  })),
  // JSON-LD goes through the head prop so each script keeps its json-ld-<id> element id, which the
  // runtime injectAllSchemas() uses to update the scripts after a language switch.
  ...schemas.map(({ id, value }) => ({
    tag: "script",
    attrs: { type: "application/ld+json", id: `json-ld-${id}` },
    content: JSON.stringify(value),
  })),
]

const initialLanguage = defaultLanguage
const initialFooterLinks = buildCostFooterLinks(initialLanguage)
const secondaryLanguages = supportedLanguages.filter((language) => language !== initialLanguage)
---

<!doctype html>
<html lang={initialLanguage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{metadata.title}</title>
    <SEOHead
      page={{
        url: metadata.url,
        title: metadata.title,
        description: metadata.description,
        image: metadata.image,
      }}
      head={seoHeadEntries}
    />

    <!-- Google Analytics 4 -->
    <GoogleAnalytics measurementId="G-EN03FMT2Q4" />
    <Analytics51LA siteId={import.meta.env.VITE_51LA_ID || "L6b88a5yK4h2Xnci"} />
  </head>
  <body>
    <IncomeTokenExperienceIsland client:load />

    <PromotoBanner locale={initialLanguage} />
    <Footer locale={initialLanguage} links={initialFooterLinks} />

    {secondaryLanguages.map((language) => (
      <template data-locale={language}>
        <Footer locale={language} links={buildCostFooterLinks(language)} />
      </template>
    ))}

    <script is:inline define:vars={{ defaultLanguage }}>
      (() => {
        const root = document.documentElement;
        const footer = document.querySelector('footer.hagilight-footer');
        const banner = document.querySelector('hagilight-promoto-banner');
        const footerForLocale = (locale) =>
          document.querySelector(`template[data-locale="${locale}"]`)?.content.querySelector('footer');
        const applyLocale = (locale) => {
          if (!locale) return;
          if (footer) {
            const replacement = footerForLocale(locale) || footerForLocale(defaultLanguage);
            if (replacement) footer.innerHTML = replacement.innerHTML;
            footer.dataset.locale = locale;
          }
          if (banner) {
            banner.dataset.locale = locale;
            document.dispatchEvent(new Event('astro:page-load'));
          }
        };
        applyLocale(root.lang || defaultLanguage);
        new MutationObserver(() => applyLocale(root.lang || defaultLanguage)).observe(root, {
          attributes: true,
          attributeFilter: ['lang'],
        });
      })();
    </script>
  </body>
</html>